{
  "name": "chaintrap-agent-shield",
  "displayName": "Chaintrap Agent Shield — AI-Coding Security",
  "description": "AI-coding supply-chain security: scan npm/PyPI and MCP pins, flag malware and CVEs, then Fix issues — delete known-bad pins and write exact OSV-clean versions. Manifest edits only.",
  "version": "0.1.33",
  "publisher": "pri17m",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#081122",
    "theme": "dark"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "ai-coding",
    "ai agent",
    "mcp",
    "mcp security",
    "osv",
    "npm",
    "pypi",
    "dependency scanning",
    "dependency security",
    "supply-chain",
    "supply chain security",
    "malware",
    "cve",
    "ghsa",
    "cursor",
    "security"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "chaintrap.rescanBaseline",
        "title": "Chaintrap: Rescan workspace baseline"
      },
      {
        "command": "chaintrap.reviewDelta",
        "title": "Chaintrap: Review agent changes since last session"
      },
      {
        "command": "chaintrap.focusPosture",
        "title": "Chaintrap: Show workspace posture"
      },
      {
        "command": "chaintrap.acknowledgeFinding",
        "title": "Chaintrap: Acknowledge high/critical finding"
      },
      {
        "command": "chaintrap.openFindingLocation",
        "title": "Chaintrap: Open finding location"
      },
      {
        "command": "chaintrap.setApiKey",
        "title": "Chaintrap: Set API key (SecretStorage)"
      },
      {
        "command": "chaintrap.clearApiKey",
        "title": "Chaintrap: Clear API key"
      },
      {
        "command": "chaintrap.scanInstalledExtensions",
        "title": "Chaintrap: Deep-scan installed VS Code extensions (API key)"
      },
      {
        "command": "chaintrap.uninstallMaliciousPackage",
        "title": "Chaintrap: Uninstall malicious package"
      },
      {
        "command": "chaintrap.pinMcpServerVersion",
        "title": "Chaintrap: Pin MCP package version"
      },
      {
        "command": "chaintrap.explainCoverageGap",
        "title": "Chaintrap: Explain coverage gap"
      },
      {
        "command": "chaintrap.fixIssues",
        "title": "Fix issues",
        "icon": "$(tools)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chaintrap",
          "title": "Chaintrap",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "chaintrap": [
        {
          "id": "chaintrap.posture",
          "name": "Workspace posture"
        },
        {
          "id": "chaintrap.activity",
          "name": "Dependencies"
        },
        {
          "id": "chaintrap.mcp",
          "name": "MCP servers"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "chaintrap.fixIssues",
          "when": "view == chaintrap.posture || view == chaintrap.activity || view == chaintrap.mcp",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "chaintrap.uninstallMaliciousPackage",
          "when": "view == chaintrap.activity && viewItem == maliciousPackage",
          "group": "inline"
        },
        {
          "command": "chaintrap.uninstallMaliciousPackage",
          "when": "view == chaintrap.activity && viewItem == maliciousPackage",
          "group": "0_actions"
        },
        {
          "command": "chaintrap.uninstallMaliciousPackage",
          "when": "view == chaintrap.mcp && viewItem == maliciousMcpServer",
          "group": "inline"
        },
        {
          "command": "chaintrap.uninstallMaliciousPackage",
          "when": "view == chaintrap.mcp && viewItem == maliciousMcpServer",
          "group": "0_actions"
        },
        {
          "command": "chaintrap.pinMcpServerVersion",
          "when": "view == chaintrap.mcp && viewItem == unpinnedMcpServer",
          "group": "inline"
        },
        {
          "command": "chaintrap.pinMcpServerVersion",
          "when": "view == chaintrap.mcp && viewItem == unpinnedMcpServer",
          "group": "0_actions"
        },
        {
          "command": "chaintrap.pinMcpServerVersion",
          "when": "view == chaintrap.posture && viewItem == postureRow.unpinnedMcp",
          "group": "inline"
        },
        {
          "command": "chaintrap.pinMcpServerVersion",
          "when": "view == chaintrap.posture && viewItem == postureRow.unpinnedMcp",
          "group": "0_actions"
        }
      ]
    },
    "configuration": {
      "title": "Chaintrap Agent Shield",
      "properties": {
        "chaintrap.apiBase": {
          "type": "string",
          "default": "https://scan.chaintrap.com",
          "description": "Chaintrap API base URL for optional deep VS Code extension scans."
        },
        "chaintrap.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "**Deprecated.** Use **Chaintrap: Set API key** (SecretStorage). Plaintext values are migrated once on activate then cleared when possible."
        },
        "chaintrap.enableDeepExtensionScan": {
          "type": "boolean",
          "default": false,
          "description": "When an API key is set, queue deep scans for newly installed VS Code extensions."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && mocha --ui tdd --timeout 10000 out/test/**/*.test.js",
    "package": "vsce package --no-dependencies",
    "sync-intel": "node scripts/sync-intel.mjs"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.9.2",
    "mocha": "12.0.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pri17m/chaintrap-agent-shield.git"
  },
  "bugs": {
    "url": "https://github.com/pri17m/chaintrap-agent-shield/issues"
  },
  "homepage": "https://marketplace.visualstudio.com/items?itemName=pri17m.chaintrap-agent-shield",
  "qna": "marketplace",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "restrictedConfigurations": [
        "chaintrap.apiKey"
      ],
      "description": "Reads lockfiles, MCP configs, skills, and rules. Does not execute workspace code."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Needs a local filesystem to inventory packages, MCP, skills, and rules."
    }
  }
}
